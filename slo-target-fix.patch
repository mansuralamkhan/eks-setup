@@ -0,0 +1,31 @@
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: slo-demo
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "1"
+spec:
+  project: default
+  source:
+    repoURL: https://github.com/mansuralamkhan/eks-setup.git
+    targetRevision: main
+    path: 05-gitops/manifests/slo-demo
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: slo-demo
+  # Lets you run the SLO fire drill (`kubectl scale ... --replicas=0`) without Argo CD
+  # immediately putting the replicas back.
+  ignoreDifferences:
+    - group: apps
+      kind: Deployment
+      name: demo-app
+      jsonPointers:
+        - /spec/replicas
+  syncPolicy:
+    automated:
+      prune: true
+      selfHeal: true
+    syncOptions:
+      - CreateNamespace=true
+      - RespectIgnoreDifferences=true
diff --git a/05-gitops/manifests/slo-demo/deployment.yaml b/05-gitops/manifests/slo-demo/deployment.yaml
new file mode 100644
index 0000000..d789d71
--- /dev/null
+++ b/05-gitops/manifests/slo-demo/deployment.yaml
@@ -0,0 +1,49 @@
+# Small, self-contained workload that the availability SLO probes (ADR-005).
+# No secrets and no external dependencies, so it is healthy as soon as it syncs.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: demo-app
+  labels:
+    app: demo-app
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: demo-app
+  template:
+    metadata:
+      labels:
+        app: demo-app
+    spec:
+      securityContext:
+        runAsNonRoot: true
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: demo-app
+          image: nginxinc/nginx-unprivileged:1.27-alpine
+          ports:
+            - containerPort: 8080
+          readinessProbe:
+            httpGet:
+              path: /
+              port: 8080
+            periodSeconds: 5
+          livenessProbe:
+            httpGet:
+              path: /
+              port: 8080
+            initialDelaySeconds: 10
+            periodSeconds: 10
+          securityContext:
+            allowPrivilegeEscalation: false
+            capabilities:
+              drop: ["ALL"]
+          resources:
+            requests:
+              cpu: 25m
+              memory: 32Mi
+            limits:
+              cpu: 100m
+              memory: 64Mi
