--- /dev/null
+++ b/05-gitops/apps/repo-karpenter-oci.yaml
@@ -0,0 +1,17 @@
+# Registers the public Karpenter OCI registry with Argo CD (no credentials needed).
+# If you already ran `argocd repo add public.ecr.aws/karpenter --type helm --enable-oci`,
+# you can delete this file.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: repo-karpenter-oci
+  namespace: argocd
+  labels:
+    argocd.argoproj.io/secret-type: repository
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+stringData:
+  name: karpenter
+  type: helm
+  url: public.ecr.aws/karpenter
+  enableOCI: "true"
diff --git a/07-policy/run-tests.sh b/07-policy/run-tests.sh
new file mode 100755
index 0000000..f35931c
--- /dev/null
+++ b/07-policy/run-tests.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# Offline test for the Kyverno policies. Needs the kyverno CLI (https://kyverno.io/docs/kyverno-cli/).
+# passing-*  must produce 0 failures; violating-* must produce at least 1.
+set -u
+cd "$(dirname "$0")"
+status=0
+for f in tests/*.yaml; do
+  out=$(kyverno apply policies/ --resource "$f" 2>&1)
+  fails=$(echo "$out" | sed -n 's/.*fail: \([0-9]*\).*/\1/p' | head -1)
+  fails=${fails:-0}
+  case "$(basename "$f")" in
+    passing-*)   [ "$fails" -eq 0 ] && echo "ok   $f (0 failures)" || { echo "FAIL $f expected pass"; echo "$out"; status=1; } ;;
+    violating-*) [ "$fails" -gt 0 ] && echo "ok   $f ($fails failure(s), as expected)" || { echo "FAIL $f expected violation"; echo "$out"; status=1; } ;;
+  esac
+done
+exit $status
