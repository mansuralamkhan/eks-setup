new file mode 100644
index 0000000..aae3475
--- /dev/null
+++ b/05-gitops/values/velero-values.yaml
@@ -0,0 +1,44 @@
+# ADR-009. Scope today: Kubernetes RESOURCE backups (manifests, CRDs, config).
+# Persistent volume snapshots are off: this cluster has no stateful workloads that
+# need them. Turn them on (snapshotsEnabled, volumeSnapshotLocation, EBS CSI) before
+# relying on Velero for data.
+initContainers:
+  - name: velero-plugin-for-aws
+    # Check the plugin/Velero compatibility table in the plugin's README when you bump the chart.
+    image: velero/velero-plugin-for-aws:v1.12.0
+    volumeMounts:
+      - mountPath: /target
+        name: plugins
+
+# Credentials come from EKS Pod Identity (aws_eks_pod_identity_association in
+# 01-foundation/velero.tf), not from a Secret.
+credentials:
+  useSecret: false
+
+serviceAccount:
+  server:
+    create: true
+    name: velero   # must match the Pod Identity association
+
+configuration:
+  backupStorageLocation:
+    - name: default
+      provider: aws
+      bucket: REPLACE_VELERO_BUCKET   # filled in by scripts/set-velero-bucket.sh
+      config:
+        region: ap-south-1
+  volumeSnapshotLocation: []
+
+snapshotsEnabled: false
+deployNodeAgent: false
+
+schedules:
+  daily-resources:
+    schedule: "0 2 * * *"   # 02:00 UTC
+    template:
+      ttl: 72h0m0s
+      snapshotVolumes: false
+      excludedNamespaces:
+        - kube-system
+        - kube-public
+        - kube-node-lease
diff --git a/07-policy/policies/verify-image-signatures.yaml b/07-policy/policies/verify-image-signatures.yaml
new file mode 100644
index 0000000..12c5bf1
--- /dev/null
+++ b/07-policy/policies/verify-image-signatures.yaml
@@ -0,0 +1,36 @@
+# ADR-008: images from this repo's GHCR namespace must be signed by this repo's
+# image workflow. Audit first (same rollout as ADR-002): violations show up in
+# PolicyReports and nothing is blocked until you switch to Enforce.
+apiVersion: kyverno.io/v1
+kind: ClusterPolicy
+metadata:
+  name: verify-image-signatures
+  annotations:
+    policies.kyverno.io/title: Verify image signatures (Cosign keyless)
+    policies.kyverno.io/category: Supply Chain Security
+    policies.kyverno.io/severity: high
+spec:
+  validationFailureAction: Audit
+  background: false
+  webhookTimeoutSeconds: 30
+  failurePolicy: Ignore   # a Sigstore outage must not block scheduling in Audit mode
+  rules:
+    - name: verify-cosign-keyless
+      match:
+        any:
+          - resources:
+              kinds:
+                - Pod
+      verifyImages:
+        - imageReferences:
+            - "ghcr.io/mansuralamkhan/eks-setup/*"
+          required: true
+          verifyDigest: true
+          mutateDigest: false   # turn on together with Enforce
+          attestors:
+            - entries:
+                - keyless:
+                    issuer: "https://token.actions.githubusercontent.com"
+                    subject: "https://github.com/mansuralamkhan/eks-setup/.github/workflows/image.yml@refs/heads/main"
+                    rekor:
+                      url: https://rekor.sigstore.dev
diff --git a/07-policy/run-tests.sh b/07-policy/run-tests.sh
new file mode 100755
index 0000000..f35931c
--- /dev/null
+++ b/07-policy/run-tests.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# Offline test for the Kyverno policies. Needs the kyverno CLI (https://kyverno.io/docs/kyverno-cli/).
+# passing-*  must produce 0 failures; violating-* must produce at least 1.
+set -u
+cd "$(dirname "$0")"
+status=0
+for f in tests/*.yaml; do
+  out=$(kyverno apply policies/ --resource "$f" 2>&1)
+  fails=$(echo "$out" | sed -n 's/.*fail: \([0-9]*\).*/\1/p' | head -1)
+  fails=${fails:-0}
+  case "$(basename "$f")" in
+    passing-*)   [ "$fails" -eq 0 ] && echo "ok   $f (0 failures)" || { echo "FAIL $f expected pass"; echo "$out"; status=1; } ;;
+    violating-*) [ "$fails" -gt 0 ] && echo "ok   $f ($fails failure(s), as expected)" || { echo "FAIL $f expected violation"; echo "$out"; status=1; } ;;
+  esac
+done
+exit $status
diff --git a/08-observability/alerts/prometheusrule-workload.yaml b/08-observability/alerts/prometheusrule-workload.yaml
new file mode 100644
index 0000000..ddc7222
--- /dev/null
+++ b/08-observability/alerts/prometheusrule-workload.yaml
@@ -0,0 +1,44 @@
+# Closes the gap found in Incident 01: a restart-count panel cannot see ImagePullBackOff,
+# because the container never starts. These alerts watch the waiting reason directly,
+# and Incident 02's OOMKilled case.
+apiVersion: monitoring.coreos.com/v1
+kind: PrometheusRule
+metadata:
+  name: workload-health
+  namespace: monitoring
+  labels:
+    app.kubernetes.io/part-of: workload-alerts
+spec:
+  groups:
+    - name: workload-health
+      rules:
+        - alert: PodImagePullFailure
+          expr: |
+            max by (namespace, pod, container, reason) (
+              kube_pod_container_status_waiting_reason{reason=~"ErrImagePull|ImagePullBackOff|InvalidImageName"}
+            ) == 1
+          for: 3m
+          labels:
+            severity: ticket
+          annotations:
+            summary: "{{ $labels.namespace }}/{{ $labels.pod }} cannot pull its image ({{ $labels.reason }})"
+            description: Check the image tag and registry access. This never shows up as a restart (Incident 01).
+        - alert: PodOOMKilled
+          expr: |
+            max by (namespace, pod, container) (
+              kube_pod_container_status_last_terminated_reason{reason="OOMKilled"}
+            ) == 1
+            and on (namespace, pod, container)
+            increase(kube_pod_container_status_restarts_total[10m]) > 0
+          labels:
+            severity: ticket
+          annotations:
+            summary: "{{ $labels.namespace }}/{{ $labels.pod }} was OOMKilled"
+            description: Compare the memory working set with the container limit (Incident 02).
+        - alert: PodCrashLooping
+          expr: increase(kube_pod_container_status_restarts_total[15m]) > 3
+          for: 5m
+          labels:
+            severity: ticket
+          annotations:
+            summary: "{{ $labels.namespace }}/{{ $labels.pod }} is restarting repeatedly"
